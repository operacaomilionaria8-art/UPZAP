EVOLUTION_API_URL="https://textbook-antonio-salt-latex.trycloudflare.com"

# API Key da Evolution API (Global API Key ou Instance Token)
EVOLUTION_API_KEY="UpZap_2026_Conexao_Real_009@"

# Nome da instância no WhatsApp (ex: upzap)
